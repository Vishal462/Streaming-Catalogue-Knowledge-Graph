@prefix : <http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/> .

<http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue> rdf:type owl:Ontology .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/creditRole
:creditRole rdf:type owl:ObjectProperty ;
            rdfs:domain :ContributorCredit ;
            rdfs:range :Role ;
            rdfs:comment "The role held in a contributor credit."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/creditedPerson
:creditedPerson rdf:type owl:ObjectProperty ;
                rdfs:domain :ContributorCredit ;
                rdfs:range :Person ;
                rdfs:comment "The person named in a contributor credit."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/forWork
:forWork rdf:type owl:ObjectProperty ;
         rdfs:domain :Availability ;
         rdfs:range :CreativeWork ;
         rdfs:comment "The creative work an availability period refers to."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/hasAvailability
:hasAvailability rdf:type owl:ObjectProperty ;
                 rdfs:domain :License ;
                 rdfs:range :Availability ;
                 rdfs:comment "Links a licence to an availability period granted under it."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/hasCredit
:hasCredit rdf:type owl:ObjectProperty ;
           rdfs:domain :CreativeWork ;
           rdfs:range :ContributorCredit ;
           rdfs:comment "Links a creative work to a contributor credit."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/hasEpisode
:hasEpisode rdf:type owl:ObjectProperty ;
            rdfs:domain :Series ;
            rdfs:range :Episode ;
            rdfs:comment "Links a series to one of its episodes."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/hasGenre
:hasGenre rdf:type owl:ObjectProperty ;
          rdfs:domain :CreativeWork ;
          rdfs:range :Genre ;
          rdfs:comment "Links a creative work to its genre."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/hasLanguage
:hasLanguage rdf:type owl:ObjectProperty ;
             rdfs:domain :CreativeWork ;
             rdfs:range :Language ;
             rdfs:comment "Links a creative work to a language version it is offered in."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/hasLicense
:hasLicense rdf:type owl:ObjectProperty ;
            rdfs:domain :CreativeWork ;
            rdfs:range :License ;
            rdfs:comment "Links a creative work to a licence that covers it."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/licensedForRegion
:licensedForRegion rdf:type owl:ObjectProperty ;
                   rdfs:domain :License ;
                   rdfs:range :Region ;
                   rdfs:comment "The region a licence applies to."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/partOfSeries
:partOfSeries rdf:type owl:ObjectProperty ;
              rdfs:domain :Episode ;
              rdfs:range :Series ;
              rdfs:comment "Links an episode to the series it belongs to."@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue#availableFrom
:availableFrom rdf:type owl:DatatypeProperty ;
               rdfs:domain :Availability ;
               rdfs:range xsd:date ;
               rdfs:comment "First day a work is offered on the platform."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue#availableUntil
:availableUntil rdf:type owl:DatatypeProperty ;
                rdfs:domain :Availability ;
                rdfs:range xsd:date ;
                rdfs:comment "Last day a work is offered on the platform."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/availabilityStatus
:availabilityStatus rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Availability ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Convenience label (active or expired); the availability dates are the source of truth."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/duration
:duration rdf:type owl:DatatypeProperty ;
          rdfs:domain :CreativeWork ;
          rdfs:range xsd:duration ;
          rdfs:comment "Running time as an ISO 8601 duration, e.g. PT1H52M."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/endDate
:endDate rdf:type owl:DatatypeProperty ;
         rdfs:domain :License ;
         rdfs:range xsd:date ;
         rdfs:comment "Last day of a licence period."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/episodeNumber
:episodeNumber rdf:type owl:DatatypeProperty ;
               rdfs:domain :Episode ;
               rdfs:range xsd:integer ;
               rdfs:comment "Position of an episode within its series."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/releaseDate
:releaseDate rdf:type owl:DatatypeProperty ;
             rdfs:domain :CreativeWork ;
             rdfs:range xsd:date ;
             rdfs:comment "The date a creative work was first released."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/startDate
:startDate rdf:type owl:DatatypeProperty ;
           rdfs:domain :License ;
           rdfs:range xsd:date ;
           rdfs:comment "First day of a licence period."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/title
:title rdf:type owl:DatatypeProperty ;
       rdfs:domain :CreativeWork ;
       rdfs:range xsd:string ;
       rdfs:comment "The display title of a creative work."@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/Availability
:Availability rdf:type owl:Class ;
              rdfs:comment "A period during which a work is actually offered on the platform under a licence; it may be shorter than the licence."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/ContributorCredit
:ContributorCredit rdf:type owl:Class ;
                   rdfs:comment "Links one person, one role and one creative work, so a person can hold different roles on different works."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/CreativeWork
:CreativeWork rdf:type owl:Class ;
              rdfs:comment "A title in the catalogue (film, series or episode), kept separate from licences and availability."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/Episode
:Episode rdf:type owl:Class ;
         rdfs:subClassOf :CreativeWork ;
         rdfs:comment "A single instalment that is part of a series."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/Film
:Film rdf:type owl:Class ;
      rdfs:subClassOf :CreativeWork ;
      rdfs:comment "A standalone feature-length creative work."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/Genre
:Genre rdf:type owl:Class ;
       rdfs:comment "A category of creative work, such as Drama or Documentary."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/Language
:Language rdf:type owl:Class ;
          rdfs:comment "A language in which a version of a creative work is offered."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/License
:License rdf:type owl:Class ;
         rdfs:comment "The legal right to stream works in a region for a fixed period."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/Person
:Person rdf:type owl:Class ;
        rdfs:comment "A contributor who can be credited on creative works."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/Region
:Region rdf:type owl:Class ;
        rdfs:comment "A territory in which works can be licensed."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/Role
:Role rdf:type owl:Class ;
      rdfs:comment "A type of contribution such as director, actor or writer."@en .


###  http://www.semanticweb.org/visha/ontologies/2026/9/streaming-catalogue/Series
:Series rdf:type owl:Class ;
        rdfs:subClassOf :CreativeWork ;
        rdfs:comment "A creative work made up of episodes."@en .


